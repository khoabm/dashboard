# Public browser configuration only. Never put a service_role/secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Gradebook is disabled by default. For authorized synthetic UAT only, set true
# in ignored .env.local; use an exact server-approved origin (currently localhost:4173).
# Restart Vite/rebuild after changing this flag. Never put teacher tokens or keyrings here.
VITE_GRADEBOOK_ENABLED=true
