{
  "name": "khtn8-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:api": "node tests/api-smoke.mjs",
    "format": "npx --yes prettier@3.6.2 --write \"src/**/*.{js,mjs,css,html,json}\" \"tests/**/*.{js,mjs,html,json}\" \"scripts/**/*.{js,mjs,json}\" \"index.html\" \"vite.config.js\" \"package.json\" \".prettierrc.json\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "node scripts/format-check.mjs",
    "format:check:all": "npx --yes prettier@3.6.2 --check \"src/**/*.{js,mjs,css,html,json}\" \"tests/**/*.{js,mjs,html,json}\" \"scripts/**/*.{js,mjs,json}\" \"index.html\" \"vite.config.js\" \"package.json\" \".prettierrc.json\" \".github/workflows/*.{yml,yaml}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
